{
  "name": "storybook-app",
  "version": "0.1.0",
  "private": true,
  "description": "Storybook interactive documentation and testing portal",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build": "storybook build -o dist",
    "typecheck": "tsc --noEmit",
