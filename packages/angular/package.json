{
  "name": "@ds/angular",
  "version": "0.1.0",
  "description": "Angular standalone component library for enterprise design system",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"fs.cpSync('src', 'dist', { recursive: true, filter: (src) => src.endsWith('.css') || fs.statSync(src).isDirectory() })\"",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@ds/tokens": "*"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "@angular/forms": ">=17.0.0"
  },
  "devDependencies": {
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "rxjs": "^7.8.1",
    "typescript": "^5.7.3",
    "zone.js": "^0.15.1"
  }
}
