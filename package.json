{
  "name": "@meridian/design-system",
  "version": "1.2.0",
  "private": true,
  "packageManager": "npm@12.2.0",
  "description": "Enterprise Design System — Multi-Framework Monorepo (React, Angular, Tokens, Storybook)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:browser-artifacts": "node tools/build-browser-artifacts.mjs",
    "dev": "turbo run dev",
    "lint": "oxlint --config .oxlintrc.json packages/react/src/ apps/storybook/src/ && npm run lint:a11y",
    "lint:a11y": "node tools/check-jsx-a11y.mjs",
    "typecheck": "turbo run typecheck",
    "test:contracts": "tsc -p tests/tsconfig.phase3.json",
    "test:types": "tsc -p tests/tsconfig.phase4.json",
    "test:angular-runtime": "node tests/run-phase4-angular-browser.mjs",
    "test:focus": "node tests/phase3-focus.test.mjs",
    "test:phase3-focus": "node tests/phase3-focus.test.mjs",
    "test:phase3-contracts": "tsc -p tests/tsconfig.phase3.json",
    "test:phase3-browser": "node tests/run-phase3-browser.mjs",
    "test:phase4-browser": "node tests/run-phase4-browser.mjs",
    "test:phase4-types": "tsc -p tests/tsconfig.phase4.json",
    "test:phase4-angular": "node tests/run-phase4-angular-browser.mjs",
    "test:a11y": "playwright test",
    "clean": "turbo run clean",
    "tokens:build": "node tools/build-tokens.mjs",
    "tokens:lint": "node tools/lint-tokens.mjs",
    "tokens:check": "node tools/build-tokens.mjs --check",
    "verify": "node tools/build-tokens.mjs --check && node tools/lint-tokens.mjs",
    "registry:build": "node tools/generate-registry.mjs",
    "check:browser-artifacts": "node tools/build-browser-artifacts.mjs --check",
    "verify:viewports": "node tools/verify-viewports.mjs"
  },
  "devDependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/parser": "^8.71.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "turbo": "^2.11.7",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "^24.21.0",
    "npm": "^12.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
