{
  "name": "@meridian/design-system",
  "version": "1.2.0",
  "private": true,
  "packageManager": "npm@11.6.4",
  "description": "Enterprise Design System — Multi-Framework Monorepo (React, Angular, Tokens, Storybook)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:browser-artifacts": "node tools/build-browser-artifacts.mjs",
    "dev": "turbo run dev",
    "lint": "oxlint --config .oxlintrc.json packages/react/src/ apps/storybook/src/ && npm run lint:a11y",
    "lint:a11y": "node tools/check-jsx-a11y.mjs",
    "typecheck": "turbo run typecheck",
    "test:phase3-focus": "node tests/phase3-focus.test.mjs",
    "test:phase3-contracts": "tsc -p tests/tsconfig.phase3.json",
    "test:phase3-browser": "node tests/run-phase3-browser.mjs",
    "test:phase4-browser": "node tests/run-phase4-browser.mjs",
    "test:phase4-types": "tsc -p tests/tsconfig.phase4.json",
    "test:phase4-landmarks": "node tests/run-phase4-landmarks.mjs",
    "test:phase4-angular": "node tests/run-phase4-angular-browser.mjs",
    "test:a11y": "playwright test",
    "clean": "turbo run clean",
    "tokens:build": "node tools/build-tokens.mjs",
    "tokens:lint": "node tools/lint-tokens.mjs",
    "tokens:check": "node tools/build-tokens.mjs --check",
    "verify": "node tools/build-tokens.mjs --check && node tools/lint-tokens.mjs",
    "verify:assemblies": "node tools/verify-reference-assemblies.mjs",
    "check:browser-artifacts": "node tools/build-browser-artifacts.mjs --check",
    "certify:plant-operations-dashboard": "node tools/certify-plant-operations-dashboard.mjs",
    "stress:plant-operations-dashboard": "node tools/stress-plant-operations-dashboard.mjs",
    "certify:maintenance-request-form": "node tools/certify-maintenance-request-form.mjs",
    "stress:maintenance-request-form": "node tools/stress-maintenance-request-form.mjs",
    "certify:production-analytics": "node tools/certify-production-analytics.mjs",
    "stress:production-analytics": "node tools/stress-production-analytics.mjs",
    "certify:plant-settings": "node tools/certify-plant-settings.mjs",
    "stress:plant-settings": "node tools/stress-plant-settings.mjs",
    "certify:work-order-register": "node tools/certify-work-order-register.mjs",
    "stress:work-order-register": "node tools/stress-work-order-register.mjs",
    "certify:work-order-detail": "node tools/certify-work-order-detail.mjs",
    "stress:work-order-detail": "node tools/stress-work-order-detail.mjs",
    "certify:planner-workbench": "node tools/certify-planner-workbench.mjs",
    "stress:planner-workbench": "node tools/stress-planner-workbench.mjs",
    "verify:viewports": "node tools/verify-viewports.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/parser": "^8.71.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "turbo": "^2.11.7",
    "typescript": "^5.7.3"
  }
}
